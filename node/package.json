{
  "name": "webex-message-handler",
  "version": "0.6.5",
  "description": "Lightweight Webex Mercury WebSocket + KMS decryption for receiving bot messages without the full Webex SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/",
    "test": "jest",
    "example": "node --env-file=.env node_modules/.bin/tsx examples/basic-bot.ts",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "webex",
    "mercury",
    "websocket",
    "kms",
    "bot",
    "messaging"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3rg0n/webex-message-handler.git",
    "directory": "node"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.4.0"
  },
  "dependencies": {
    "node-jose": "^2.2.0",
    "node-kms": "^0.4.1",
    "undici": "^7.24.6",
    "uuid": "^11.1.0"
  },
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.1"
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
